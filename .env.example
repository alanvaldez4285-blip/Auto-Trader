# Copy to .env and fill in. Never commit .env.
DISCORD_TOKEN=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Robinhood (only if broker.name is robinhood). Unofficial API: read the README warning first.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Optional: the setup key from Robinhood's authenticator-app 2FA, so logins need no manual code.
ROBINHOOD_MFA_SECRET=
